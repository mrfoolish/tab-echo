{
  "manifest_version": 3,
  "name": "Tab Echo",
  "description": "A lightweight enhanced reopen-closed-tabs extension with searchable grouped close history.",
  "version": "1.0.0",
  "action": {
    "default_title": "Tab Echo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "split"
}
